# workloads/backend/.env.example — Contoh konfigurasi variabel lingkungan backend tenant
PORT=3000
NODE_ENV=development
TENANT_NAME=__TENANT_NAME__
TENANT_TIER=basic
STORAGE_PARTITION_PREFIX=s3://saas-shared-bucket/tenants/__TENANT_NAME__/
DATABASE_URL=postgres://db_user:__CHANGE_ME__@localhost:5432/saas_db
